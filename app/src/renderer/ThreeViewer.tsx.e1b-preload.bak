  <div className="viewer-tools"><div className="viewer-tools-left"><div className="picker-anchor"><button className="source-art-button" disabled={!imageChoices.length} aria-label="Source art overlay" title="Source art overlay" onClick={()=>setSourceArtOpen(v=>!v)}><Image size={13}/> {sourceArtUrl?"Art overlay":"Source art"}</button>{imageChoices.length>0&&sourceArtOpen&&<div className="viewer-popover channel-popover">{imageChoices.map(art=><button key={art.id} className={sourceArtId===art.id?"selected":""} onClick={()=>{setSourceArtId(art.id);setSourceArtOpen(false)}}>{art.name}</button>)}<button onClick={()=>{setSourceArtId("");setSourceArtOpen(false)}}>Clear source art</button>{sourceArtUrl&&<><label className="overlay-opacity">Opacity <input aria-label="Source art opacity" type="range" min={0} max={1} step={.05} value={sourceArtOpacity} onChange={e=>setSourceArtOpacity(Number(e.target.value))}/></label><label className="overlay-opacity">Align X <input aria-label="Source art horizontal alignment" type="range" min={-50} max={50} step={1} value={sourceArtAlignment.x} onChange={e=>updateArtAlignment("x",Number(e.target.value))}/></label><label className="overlay-opacity">Align Y <input aria-label="Source art vertical alignment" type="range" min={-50} max={50} step={1} value={sourceArtAlignment.y} onChange={e=>updateArtAlignment("y",Number(e.target.value))}/></label><label className="overlay-opacity">Scale <input aria-label="Source art scale" type="range" min={.5} max={2} step={.01} value={sourceArtAlignment.scale} onChange={e=>updateArtAlignment("scale",Number(e.target.value))}/></label></>}</div>}</div><div className="picker-anchor"><button aria-label="Front axis calibration" className="viewer-picker compact" onClick={()=>setFrontPicker(v=>!v)}>Front {frontAxis.toUpperCase()}<ChevronDown size={12}/></button>{frontPicker&&<div className="viewer-popover channel-popover">{(['z','-z','x','-x'] as const).map(axis=><button key={axis} className={frontAxis===axis?'selected':''} onClick={()=>{setFrontAxis(axis);localStorage.setItem(frontAxisStorageKey(assemblySourceRef.current||choices.find(item=>item.id===activeAsset.current?.id),character.id),axis);setFrontPicker(false);setView('front',axis)}}>Front from {axis.toUpperCase()}</button>)}</div>}</div><div className="picker-anchor"><button className="viewer-picker" onClick={()=>setFilePicker(v=>!v)}><Box size={14}/><span>{choices.find(f=>f.name===selected)?.name||'Choose model'}</span><ChevronDown size={13}/></button>{filePicker&&<div className="viewer-popover" role="listbox">{choices.map(file=><button key={file.id} onClick={()=>{setFilePicker(false);void load(file)}}><span>{file.name}</span><small>{file.data.versionNumber?`v${file.data.versionNumber}`:file.data.bytes?`${Math.round(file.data.bytes/1024)} KB`:file.data.sourceName}</small></button>)}</div>}</div><div className="picker-anchor"><button className="viewer-picker compact" onClick={()=>setChannelPicker(v=>!v)}><Image size={14}/>{channel}<ChevronDown size={13}/></button>{channelPicker&&<div className="viewer-popover channel-popover">{(['albedo','normal','roughness','metallic'] as const).map(item=><button key={item} className={channel===item?'selected':''} onClick={()=>{setChannelPicker(false);applyChannel(item)}}>{item}</button>)}</div>}</div><div className="picker-anchor"><button className="viewer-picker compact" disabled={!objects.length} onClick={()=>setComparePicker(v=>!v)}><Layers3 size={13}/>{compareId?choices.find(x=>x.id===compareId)?.name||"Compare":"Compare"}<ChevronDown size={12}/></button>{comparePicker&&<div className="viewer-popover channel-popover">{choices.filter(x=>x.name!==selected).map(file=><button key={file.id} onClick={()=>{setComparePicker(false);void loadCompare(file)}}>{file.name}</button>)}</div>}</div>{compareRootRef.current&&<button className={overlay?"selected":""} title="Show or hide comparison overlay" onClick={()=>{const next=!overlay;setOverlay(next);if(compareRootRef.current)compareRootRef.current.visible=next;}}>Overlay</button>}<button className={fixedCompare?"selected":""} title="Lock comparison camera and lighting" onClick={()=>{const next=!fixedCompare;setFixedCompare(next);const state=getState();if(state)state.controls.enabled=!next;if(next)setView("front");}}><Camera size={13}/>Lock</button></div><div className="viewer-tools-right"><button aria-label="Front view" title="Front view" className={view==='front'?'selected':''} onClick={()=>setView('front')}>Front</button><button aria-label="Left view" title="Left view" className={view==='left'?'selected':''} onClick={()=>setView('left')}>Left</button><button aria-label="Right view" title="Right view" className={view==='right'?'selected':''} onClick={()=>setView('right')}>Right</button><button aria-label="Back view" title="Back view" className={view==='back'?'selected':''} onClick={()=>setView('back')}>Back</button><button aria-label="Top view" title="Top view" className={view==='top'?'selected':''} onClick={()=>setView('top')}>Top</button><button aria-label="Reset camera" title="Reset camera" onClick={reset}><RotateCcw size={14}/></button><button aria-label="Toggle projection" title={`${projection} projection`} onClick={()=>setProjectionMode(projection==='perspective'?'orthographic':'perspective')}><Camera size={14}/><span>{projection==='perspective'?'Persp':'Ortho'}</span></button><button aria-label="Toggle wireframe" title="Wireframe" className={wire?'selected':''} onClick={()=>{setWire(v=>{const next=!v;for(const [mesh,original] of originalMaterials.current){const mats=Array.isArray(original)?original:[original];for(const material of mats)(material as any).wireframe=next;}return next;})}}><Scan size={14}/></button><button aria-label="Toggle bones" title="Toggle skeleton overlay" className={bones?'selected':''} onClick={()=>{const next=!bones;setBones(next);for(const root of objects)for(const helper of (root as any).userData.skeletonHelpers||[])helper.visible=next;}}><Waypoints size={14}/></button><button aria-label="Toggle weight overlay" title="Visualize dominant skin weights" className={weightOverlay?'selected':''} disabled={!objects.some((root:any)=>{let has=false;root.traverse((item:any)=>{if(item.isSkinnedMesh)has=true});return has})} onClick={toggleWeightOverlay}><Waypoints size={14}/><span>Weights</span></button><button aria-label="Toggle isolate" title="Isolate selected object" className={isolated?'selected':''} disabled={!activeObject} onClick={()=>{const next=!isolated;if(next){visibilityBeforeIsolate.current.clear();for(const row of treeItems)visibilityBeforeIsolate.current.set(row.object,row.object.visible);const target=treeItems.find(row=>row.object.name===activeObject)?.object,visible=new Set<THREE.Object3D>();for(let item:THREE.Object3D|null|undefined=target;item;item=item.parent)visible.add(item);for(const row of treeItems)row.object.visible=visible.has(row.object);}else for(const [object,wasVisible] of visibilityBeforeIsolate.current)object.visible=wasVisible;setIsolated(next);}}><Eye size={14}/></button></div></div>
  <div className="viewer-playback"><button aria-label="Rest pose" title="Rest pose" onClick={()=>sharedPlayback.current.rest()}><RotateCcw size={13}/> Rest</button><button aria-label={playing?'Pause animation':'Play animation'} title={playing?'Pause':'Play'} disabled={!clips.length} onClick={()=>sharedPlayback.current.toggle()}>{playing?<Pause size={14}/>:<Play size={14}/>}</button><div className="picker-anchor"><button disabled={!clips.length} className="viewer-picker compact" onClick={()=>setClipPicker(v=>!v)}>{clip||'No animation clips'}<ChevronDown size={12}/></button>{clipPicker&&<div className="viewer-popover clip-popover">{clips.map(item=><button key={item.name} className={item.name===clip?'selected':''} onClick={()=>{setClipPicker(false);sharedPlayback.current.select(item.name)}}>{item.name}<small>{item.duration.toFixed(2)}s</small></button>)}</div>}</div><span className="playback-time">{frame.toFixed(2)}s</span><input aria-label="Animation frame" className="frame-slider" type="range" min={0} max={clips.find(item=>item.name===clip)?.duration||1} step={.01} value={Math.min(frame,clips.find(item=>item.name===clip)?.duration||1)} onChange={e=>sharedPlayback.current.seek(Number(e.target.value))} disabled={!clips.length}/><label className="speed-control">Speed <input type="range" min={.25} max={2} step={.25} value={speed} onChange={e=>{const next=Number(e.target.value);setSpeed(next);if(mixerRef.current)mixerRef.current.timeScale=next;if(compareMixerRef.current)compareMixerRef.current.timeScale=next}}/><span>{speed}×</span></label><button aria-label="Capture view" title="Save capture" onClick={()=>void capture()}><Camera size={14}/> Capture</button></div>
  {tree&&<aside className="viewer-hierarchy"><header><span><Layers3 size={14}/> Scene hierarchy</span><button aria-label="Hide hierarchy" onClick={()=>setTree(false)}><ChevronDown size={14}/></button></header>{objects.length?treeItems.map(({object,type,depth},i)=><div key={`${i}-${object.uuid}`} className={`hierarchy-row ${activeObject===object.name?'selected':''}`} style={{paddingLeft:10+Math.min(depth,8)*12}}><button aria-label={`${object.visible?'Hide':'Show'} ${object.name||type}`} onClick={()=>{object.visible=!object.visible;setObjects([...objects])}}>{object.visible?<Eye size={12}/>:<EyeOff size={12}/>}</button><button onClick={()=>setActiveObject(object.name)}><span>{type==='Bone'?<Waypoints size={12}/>:<Box size={12}/>}</span><b>{object.name||type}</b><small>{type}</small></button></div>):<p>Choose a managed model to inspect its objects and clips.</p>}</aside>}
  <div className="assembly-dock"><button aria-expanded={showAssembly} onClick={()=>setShowAssembly(v=>!v)}><Move3D size={14}/> Part transform</button>{showAssembly&&<div className="assembly-panel"><header><strong>Checkpointed assembly</strong><span>{activeObject||'Select a part'}</span></header><p>{canAssemblyTransform?'Edits create an immutable Blender candidate. Undo and redo restore checkpoints as new review candidates.':'Load a managed .blend master or its verified Blender preview to enable saved part transforms.'}</p>{(['location','rotationDegrees','scale'] as const).map(group=><label key={group}>{group==='rotationDegrees'?'Rotation °':group==='location'?'Position':'Scale'}<div>{assemblyDraft[group].map((value,axis)=><input key={axis} aria-label={group+' '+ 'XYZ'[axis]} type="number" step=".01" value={value} onChange={event=>setAssemblyDraft(draft=>({...draft,[group]:draft[group].map((n,i)=>i===axis?(Number(event.target.value)||0):n) as any}))}/>)}</div></label>)}<footer><button disabled={assemblyBusy||!assemblyUndo.length} onClick={()=>void restoreAssembly('undo')}>Undo</button><button disabled={assemblyBusy||!assemblyRedo.length} onClick={()=>void restoreAssembly('redo')}>Redo</button><button className="primary" disabled={assemblyBusy||!activeObject||!canAssemblyTransform} onClick={()=>void commitAssembly()}>{assemblyBusy?'Working…':'Apply checkpointed transform'}</button></footer></div>}</div>
  <div className="viewer-footer"><span>{activeObject||'Orbit to inspect · double-click a mesh to select'}</span><button onClick={()=>void capture()}><Camera size={13}/> Save capture</button><span>{treeItems.filter(row=>row.type==='Mesh'||row.type==='Skinned mesh').length} meshes · {clips.length} clips</span></div>
 </div>;
}

function pathExt(name:string){return name.split('.').pop()?.toLowerCase()||'';}
function hasMoreThanEightWeights(root:THREE.Object3D){let unsupported=false;root.traverse((obj:any)=>{const g=(obj as any).geometry;if(g?.userData?.atelierWeightLimitExceeded||g?.getAttribute('skinWeight_2'))unsupported=true;});return unsupported;}

const eightWeightVertexShader=`
attribute vec4 atelierSkinIndex1;
attribute vec4 atelierSkinWeight1;
void atelierApplyEightWeights(inout vec3 transformed, inout vec3 objectNormal) {
  vec4 sourcePosition = bindMatrix * vec4(transformed, 1.0);
  vec4 skinnedPosition = vec4(0.0);
  for (int i = 0; i < 4; i++) {
    float w0 = getSkinWeight(i);
    float w1 = getSkinWeight1(i);
    int j0 = getSkinIndex(i);
    int j1 = getSkinIndex1(i);
    if (w0 > 0.0) skinnedPosition += getBoneMatrix(float(j0)) * sourcePosition * w0;
    if (w1 > 0.0) skinnedPosition += getBoneMatrix(float(j1)) * sourcePosition * w1;
  }
  transformed = (bindMatrixInverse * skinnedPosition).xyz;
}
void atelierApplyEightNormal(inout vec3 objectNormal) {
  vec4 sourceNormal = bindMatrix * vec4(objectNormal, 0.0);
  mat4 skinMatrix = mat4(0.0);
  for (int i = 0; i < 4; i++) {
    int j0 = getSkinIndex(i); int j1 = getSkinIndex1(i);
    skinMatrix += getBoneMatrix(float(j0)) * getSkinWeight(i);
    skinMatrix += getBoneMatrix(float(j1)) * getSkinWeight1(i);
  }
  objectNormal = normalize((bindMatrixInverse * skinMatrix * sourceNormal).xyz);
}
#ifdef USE_TANGENT
void atelierApplyEightTangent(inout vec3 objectTangent) {
  vec4 sourceTangent = bindMatrix * vec4(objectTangent, 0.0);
  mat4 skinMatrix = mat4(0.0);
  for (int i = 0; i < 4; i++) {
    skinMatrix += getBoneMatrix(float(getSkinIndex(i))) * getSkinWeight(i);
    skinMatrix += getBoneMatrix(float(getSkinIndex1(i))) * getSkinWeight1(i);
  }
  objectTangent = normalize((bindMatrixInverse * skinMatrix * sourceTangent).xyz);
}
#endif
`;
export function compactEightInfluenceSets(sets:Array<{joints:Float32Array;weights:Float32Array}>,vertexCount:number){
 const joint0=new Uint16Array(vertexCount*4),weight0=new Float32Array(vertexCount*4),joint1=new Float32Array(vertexCount*4),weight1=new Float32Array(vertexCount*4),rawWeights:number[][]=[];let hasExtra=false,tooMany=false,maxUsed=0;
 for(let vertex=0;vertex<vertexCount;vertex++){
  const joints:number[]=[],weights:number[]=[];
  for(const set of sets){if(set.joints.length!==vertexCount*4||set.weights.length!==vertexCount*4)throw new Error('GLTF skin accessor vertex counts do not match the mesh.');for(let c=0;c<4;c++){const offset=vertex*4+c,joint=set.joints[offset],weight=set.weights[offset];if(!Number.isFinite(joint)||!Number.isFinite(weight)||weight<0)throw new Error(`Invalid GLTF skin influence at vertex ${vertex}.`);joints.push(joint);weights.push(weight);}}
  const positive=weights.map((weight,index)=>({joint:joints[index],weight})).filter(item=>item.weight>0);const used=positive.length;maxUsed=Math.max(maxUsed,used);if(used>8)tooMany=true;const sum=positive.reduce((a,item)=>a+item.weight,0);rawWeights.push(weights);
  if(sum>0)for(let i=0;i<Math.min(8,positive.length);i++){const pair=positive[i],value=pair.weight/sum;if(i<4){joint0[vertex*4+i]=pair.joint;weight0[vertex*4+i]=value;}else{joint1[vertex*4+i-4]=pair.joint;weight1[vertex*4+i-4]=value;hasExtra ||= i>=4&&value>0;}}
 }
 return {joint0,weight0,joint1,weight1,rawWeights,hasExtra,tooMany,maxUsed};
}
export function withEightWeightAccessors(loader:GLTFLoader){
 loader.register((parser:any)=>({
  name:'atelier-eight-influence-accessors',
  beforeRoot:async()=>{const json=parser.json;parser.__atelierRawBuffers=await Promise.all((json.buffers||[]).map((_:unknown,index:number)=>parser.getDependency('buffer',index)));},
  afterRoot:async(gltf:any)=>{
   const json=parser.json,buffers=parser.__atelierRawBuffers||[];
   gltf.scene.traverse((object:any)=>{
    if(!object.isSkinnedMesh)return;
    const association=parser.associations.get(object);
    if(!association||association.meshes===undefined||association.primitives===undefined)return;
    const primitive=json.meshes[association.meshes]?.primitives?.[association.primitives],attributes=primitive?.attributes;
    if(!attributes||attributes.JOINTS_0===undefined||attributes.WEIGHTS_0===undefined)return;
    const sets:Array<{joints:Float32Array;weights:Float32Array}>=[];
    const setIds=[...new Set(Object.keys(attributes).flatMap((name:string)=>{const match=name.match(/^(?:JOINTS|WEIGHTS)_(\d+)$/);return match?[Number(match[1])]:[]}))].sort((a,b)=>a-b);
    if(setIds.length>64||setIds.some((set:number,index:number)=>set!==index))throw new Error('GLTF skin influence sets must be contiguous and no more than 64 sets.');
    for(const set of setIds){
     const jointIndex=attributes[`JOINTS_${set}`],weightIndex=attributes[`WEIGHTS_${set}`];
     if(jointIndex===undefined||weightIndex===undefined)throw new Error(`GLTF skin set ${set} must contain both JOINTS_${set} and WEIGHTS_${set}.`);
     sets.push({joints:decodeGltfAccessor(json,buffers,jointIndex),weights:decodeGltfAccessor(json,buffers,weightIndex)});
    }
    if(!sets.length)return;
    const geometry=(object.geometry as THREE.BufferGeometry).clone(),vertexCount=geometry.getAttribute('position').count;object.geometry=geometry;
    const compact=compactEightInfluenceSets(sets,vertexCount),{joint0,weight0,joint1,weight1,rawWeights,hasExtra,tooMany,maxUsed}=compact;
    geometry.userData.atelierRawWeights=rawWeights;
    geometry.userData.atelierInfluenceCount=maxUsed;
    if(tooMany){geometry.userData.atelierWeightLimitExceeded=true;return;}
    geometry.setAttribute('skinIndex',new THREE.BufferAttribute(joint0,4));
    geometry.setAttribute('skinWeight',new THREE.BufferAttribute(weight0,4));
    geometry.setAttribute('atelierJoint1',new THREE.BufferAttribute(joint1,4));
    geometry.setAttribute('atelierWeight1',new THREE.BufferAttribute(weight1,4));
   });
  }
 }));
 return loader;
}
function toArrayBuffer(value:any):ArrayBuffer{return value instanceof ArrayBuffer?value:value.buffer.slice(value.byteOffset,value.byteOffset+value.byteLength);}
export function decodeGltfAccessor(json:any,buffers:any[],index:number){
 const accessor=json.accessors[index],components=({SCALAR:1,VEC2:2,VEC3:3,VEC4:4,MAT2:4,MAT3:9,MAT4:16} as Record<string,number>)[accessor?.type],componentSize=({5120:1,5121:1,5122:2,5123:2,5125:4,5126:4} as Record<number,number>)[accessor?.componentType];
 if(!accessor||!components||!componentSize||accessor.count>20_000_000)throw new Error('GLTF skin accessor has an unsupported shape or size.');
 const output=new Float32Array(accessor.count*components);
 const reader=(bufferIndex:number,byteOffset:number,stride:number,target:Float32Array,count:number,component:number)=>{
  const view=new DataView(toArrayBuffer(buffers[bufferIndex]));
  for(let item=0;item<count;item++)for(let c=0;c<components;c++){
   const at=byteOffset+item*stride+c*componentSize;
   let value=componentSize===1?(accessor.componentType===5120?view.getInt8(at):view.getUint8(at)):componentSize===2?(accessor.componentType===5122?view.getInt16(at,true):view.getUint16(at,true)):accessor.componentType===5125?view.getUint32(at,true):view.getFloat32(at,true);
   if(accessor.normalized){if(accessor.componentType===5120)value=Math.max(value/127,-1);else if(accessor.componentType===5121)value/=255;else if(accessor.componentType===5122)value=Math.max(value/32767,-1);else if(accessor.componentType===5123)value/=65535;}
   target[item*components+c]=value;
  }
 };
 if(accessor.bufferView!==undefined){const bv=json.bufferViews[accessor.bufferView];reader(bv.buffer,(bv.byteOffset||0)+(accessor.byteOffset||0),bv.byteStride||components*componentSize,output,accessor.count,accessor.componentType);}
 if(accessor.sparse){const sparse=accessor.sparse,iv=json.bufferViews[sparse.indices.bufferView],ib=new DataView(toArrayBuffer(buffers[iv.buffer])),isize=({5121:1,5123:2,5125:4} as Record<number,number>)[sparse.indices.componentType],vv=json.bufferViews[sparse.values.bufferView],vb=new DataView(toArrayBuffer(buffers[vv.buffer]));if(!isize)throw new Error('Unsupported GLTF sparse index type.');for(let k=0;k<sparse.count;k++){const io=(iv.byteOffset||0)+(sparse.indices.byteOffset||0)+k*isize,vertex=isize===1?ib.getUint8(io):isize===2?ib.getUint16(io,true):ib.getUint32(io,true);if(vertex>=accessor.count)throw new Error('GLTF sparse skin index is out of bounds.');for(let c=0;c<components;c++){const at=(vv.byteOffset||0)+(sparse.values.byteOffset||0)+(k*components+c)*componentSize;let value=componentSize===1?(accessor.componentType===5120?vb.getInt8(at):vb.getUint8(at)):componentSize===2?(accessor.componentType===5122?vb.getInt16(at,true):vb.getUint16(at,true)):accessor.componentType===5125?vb.getUint32(at,true):vb.getFloat32(at,true);if(accessor.normalized){if(accessor.componentType===5120)value=Math.max(value/127,-1);else if(accessor.componentType===5121)value/=255;else if(accessor.componentType===5122)value=Math.max(value/32767,-1);else if(accessor.componentType===5123)value/=65535;}output[vertex*components+c]=value;}}}
 return output;
}
export function applyEightInfluencePosition(position:THREE.Vector3,bind:THREE.Matrix4,bindInverse:THREE.Matrix4,boneMatrices:ArrayLike<number>,joints:number[],weights:number[]){const source=position.clone().applyMatrix4(bind),result=new THREE.Vector3(),bone=new THREE.Matrix4();let sum=0;for(let i=0;i<Math.min(8,weights.length);i++){const weight=weights[i];if(weight<=0)continue;bone.fromArray(Array.from({length:16},(_,k)=>boneMatrices[joints[i]*16+k]),0);result.addScaledVector(source.clone().applyMatrix4(bone),weight);sum+=weight;}return sum?result.applyMatrix4(bindInverse):position.clone();}
const patchedMaterials=new WeakSet<THREE.Material>();
function patchEightWeightSkinning(mesh:THREE.SkinnedMesh){
 const geometry=mesh.geometry as THREE.BufferGeometry;if(!geometry.getAttribute('atelierWeight1'))return;
 const patchMaterial=(material:THREE.Material)=>{if(geometry.getAttribute('tangent')){material.defines={...(material.defines||{}),USE_TANGENT:1};material.needsUpdate=true;}if(patchedMaterials.has(material))return;patchedMaterials.add(material);const prior=material.onBeforeCompile;material.onBeforeCompile=(shader,renderer)=>{prior.call(material,shader,renderer);shader.vertexShader=shader.vertexShader.replace('#include <skinning_pars_vertex>','#include <skinning_pars_vertex>\nattribute vec4 atelierJoint1;\nattribute vec4 atelierWeight1;\nint getSkinIndex(int i){return int(i==0?skinIndex.x:i==1?skinIndex.y:i==2?skinIndex.z:skinIndex.w);}\nfloat getSkinWeight(int i){return i==0?skinWeight.x:i==1?skinWeight.y:i==2?skinWeight.z:skinWeight.w;}\nint getSkinIndex1(int i){return int(i==0?atelierJoint1.x:i==1?atelierJoint1.y:i==2?atelierJoint1.z:atelierJoint1.w);}\nfloat getSkinWeight1(int i){return i==0?atelierWeight1.x:i==1?atelierWeight1.y:i==2?atelierWeight1.z:atelierWeight1.w;}\n'+eightWeightVertexShader);const hasNormal=['MeshStandardMaterial','MeshPhysicalMaterial','MeshPhongMaterial','MeshLambertMaterial','MeshToonMaterial'].includes(material.type),normalPatch=hasNormal?'atelierApplyEightNormal(objectNormal);\n#ifdef USE_TANGENT\natelierApplyEightTangent(objectTangent);\n#endif':'';shader.vertexShader=shader.vertexShader.replace('#include <skinning_vertex>','vec3 atelierSkinNormalStub = vec3(0.0, 1.0, 0.0); atelierApplyEightWeights(transformed, atelierSkinNormalStub);').replace('#include <skinnormal_vertex>',normalPatch);};material.customProgramCacheKey=()=>`atelier-eight-weight-${material.uuid}`;material.needsUpdate=true;};
 (Array.isArray(mesh.material)?mesh.material:[mesh.material]).forEach(patchMaterial);if((mesh.userData as any).atelierEightCpuPatched)return;(mesh.userData as any).atelierEightCpuPatched=true;
 const depth=new THREE.MeshDepthMaterial({depthPacking:THREE.RGBADepthPacking}),distance=new THREE.MeshDistanceMaterial();patchMaterial(depth);patchMaterial(distance);const distanceCompile=distance.onBeforeCompile.bind(distance);distance.onBeforeCompile=(shader,renderer)=>{distanceCompile(shader,renderer);(distance.userData as any).atelierUniforms=shader.uniforms;};mesh.customDepthMaterial=depth;mesh.customDistanceMaterial=distance;
 const original=mesh.applyBoneTransform.bind(mesh);(mesh as any).applyBoneTransform=(index:number,target:THREE.Vector3|THREE.Vector4)=>{if(!(target as any).isVector3)return original(index,target as any);const skinIndex=geometry.getAttribute('skinIndex') as THREE.BufferAttribute,skinWeight=geometry.getAttribute('skinWeight') as THREE.BufferAttribute,joint1=geometry.getAttribute('atelierJoint1') as THREE.BufferAttribute,weight1=geometry.getAttribute('atelierWeight1') as THREE.BufferAttribute;if(!joint1||!weight1)return original(index,target as any);const joints:number[]=[],weights:number[]=[];for(let c=0;c<4;c++){joints.push(skinIndex.getComponent(index,c),joint1.getComponent(index,c));weights.push(skinWeight.getComponent(index,c),weight1.getComponent(index,c));}const skinned=applyEightInfluencePosition((target as THREE.Vector3).clone(),mesh.bindMatrix,mesh.bindMatrixInverse,mesh.skeleton.boneMatrices!,joints,weights);return (target as THREE.Vector3).copy(skinned);};
 const originalBounds=mesh.computeBoundingSphere.bind(mesh);(mesh as any).computeBoundingSphere=()=>{const position=geometry.getAttribute('position');if(!position){originalBounds();return;}mesh.updateMatrixWorld(true);mesh.skeleton.update();const points:THREE.Vector3[]=[];for(let i=0;i<position.count;i++){const local=new THREE.Vector3();(mesh as any).getVertexPosition(i,local);points.push(local);}const box=new THREE.Box3().setFromPoints(points);(mesh as any).boundingBox=box;(mesh as any).boundingSphere=box.getBoundingSphere(new THREE.Sphere());};
}

